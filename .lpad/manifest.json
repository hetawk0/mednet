{
  "version": 1,
  "project": {
    "slug": "mednet",
    "type": "unknown",
    "name": "mednet"
  },
  "lpad": {
    "apiUrl": "https://lpad.ekddigital.com",
    "linkedAt": "2026-10-01T14:43:37.334Z"
  },
  "deploy": {
    "target": "vps",
    "framework": "Unknown",
    "deployMode": "pm2",
    "platformDomain": "mednet.lpad.ekddigital.com",
    "defaultBranch": "main",
    "services": [
      {
        "name": "api",
        "type": "web",
        "role": "api",
        "rootDir": ".",
        "runtime": "java",
        "routes": [
          "/api/",
          "/actuator/",
          "/api-docs",
          "/swagger-ui"
        ],
        "healthCheckPath": "/actuator/health"
      },
      {
        "name": "web",
        "type": "web",
        "role": "frontend",
        "rootDir": "web",
        "dependsOn": [
          "api"
        ],
        "routes": [
          "/"
        ]
      }
    ]
  },
  "assets": {
    "publicBaseUrl": "https://assets.andgroupco.com",
    "apiBaseUrl": "https://assets.andgroupco.com/api/v1",
    "clientId": "mednet",
    "projectName": "mednet",
    "cdnPathTemplate": "/assets/{clientId}/{projectName}/{assetType}/{filename}"
  },
  "env": {
    "hints": [
      {
        "key": "ASSETS_API_SECRET",
        "description": "Assets API secret (sk_…) — server-only Bearer token",
        "secret": true,
        "required": true
      },
      {
        "key": "ASSETS_BASE_URL",
        "description": "Assets API origin (e.g. https://assets.andgroupco.com)",
        "required": true
      },
      {
        "key": "ASSETS_PUBLIC_BASE_URL",
        "description": "Public CDN origin for relative asset paths"
      },
      {
        "key": "ASSETS_CLIENT_ID",
        "description": "Assets client_id namespace (default: mednet)"
      },
      {
        "key": "MEDNET_ADMIN_EMAIL",
        "description": "Initial MedNet administrator email",
        "required": true
      },
      {
        "key": "MEDNET_ADMIN_PASSWORD",
        "description": "Initial MedNet administrator password",
        "secret": true,
        "required": true
      },
      {
        "key": "SESSION_COOKIE_SECURE",
        "description": "Set true for the HTTPS production deployment"
      },
      {
        "key": "SPRING_DATASOURCE_URL",
        "description": "PostgreSQL JDBC URL for admin workflow persistence",
        "required": true
      },
      {
        "key": "SPRING_DATASOURCE_USERNAME",
        "description": "PostgreSQL application username",
        "required": true
      },
      {
        "key": "SPRING_DATASOURCE_PASSWORD",
        "description": "PostgreSQL application password",
        "secret": true,
        "required": true
      },
      {
        "key": "GOOGLE_OAUTH_ENABLED",
        "description": "Enable Google sign-in after OAuth credentials are configured"
      },
      {
        "key": "GOOGLE_CLIENT_ID",
        "description": "Google OAuth web client ID"
      },
      {
        "key": "GOOGLE_CLIENT_SECRET",
        "description": "Google OAuth web client secret",
        "secret": true
      },
      {
        "key": "GOOGLE_REDIRECT_URI",
        "description": "Registered Google OAuth callback URL"
      }
    ]
  },
  "nginx": {
    "routes": [
      {
        "path": "/",
        "description": "Reverse-proxied to the application process on the VPS"
      }
    ]
  }
}